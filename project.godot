; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Systemverse"
run/main_scene="uid://dgd8etrrn4sm3"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.0796393, 0.159724, 0.136647, 1)
boot_splash/show_image=false
boot_splash/image="uid://d1lol2t86votl"
config/icon="uid://cxvyvsihlybth"

[autoload]

GameStateManager="*res://scripts/autoloads/GameStateManager.gd"
SaveLoadManager="*res://scripts/autoloads/Save_LoadManager.gd"
UiManager="*res://scripts/autoloads/UIManager.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

